# Copy to .env or set as real environment variables.

# --- required for anything useful -------------------------------------------
# Where your .vmx files live. Separate several with ; on Windows, : elsewhere.
# Windows:  C:\Users\YOU\Documents\Virtual Machines
# macOS:    ~/Virtual Machines.localized
# Linux:    ~/vmware
VMWARE_VM_DIRS=

# read-only | write | destructive
# "write" clones, powers and runs commands; "destructive" also reverts/deletes.
VMWARE_PERMISSION_MODE=write

# --- guest access ------------------------------------------------------------
# Needed by the run/copy tools. Use a local admin on the golden image.
VMWARE_GUEST_USERNAME=Administrator
VMWARE_GUEST_PASSWORD=

# Scratch directory inside the guest (defaults to C:\Windows\Temp or /tmp).
# VMWARE_GUEST_TEMP_DIR=

# Password for encrypted .vmx files.
# VMWARE_VMX_PASSWORD=

# --- locating VMware ---------------------------------------------------------
# Only needed when vmrun is not on PATH.
# VMWARE_VMRUN_PATH=C:\Program Files (x86)\VMware\VMware Workstation\vmrun.exe

# ws (Workstation), fusion, or player — usually auto-detected.
# VMWARE_PRODUCT=ws

# --- host filesystem limits --------------------------------------------------
# Where copy_to_guest may read from. Unset means anywhere.
# VMWARE_HOST_READ_DIRS=C:\Builds

# Where copy_from_guest and screenshots may write. Defaults to the VM
# directories plus a temp scratch folder. Use * to allow anywhere.
# VMWARE_HOST_WRITE_DIRS=C:\TestResults

# --- limits and timeouts -----------------------------------------------------
# VMWARE_MAX_CONCURRENCY=4
# VMWARE_MAX_CLONE_BATCH=50
# VMWARE_COMMAND_TIMEOUT=120
# VMWARE_CLONE_TIMEOUT=1800
# VMWARE_GUEST_TIMEOUT=300
# VMWARE_BOOT_TIMEOUT=300
# VMWARE_MAX_OUTPUT_BYTES=100000
# VMWARE_MAX_RESULTS=500
# VMWARE_DEFAULT_PAGE_SIZE=100
# VMWARE_CACHE_TTL=5
# VMWARE_LOG_LEVEL=INFO
