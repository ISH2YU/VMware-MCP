# Copy to .env or set as real environment variables.

# Where your .vmx files live (required for anything useful)
# Windows:  C:\Users\YOU\Documents\Virtual Machines
# macOS:    ~/Virtual Machines.localized
# Linux:    ~/vmware
VMWARE_VM_DIRS=

# Optional if vmrun is not on PATH
# VMWARE_VMRUN_PATH=C:\Program Files (x86)\VMware\VMware Workstation\vmrun.exe

# ws (Workstation), fusion, or player — usually auto-detected
# VMWARE_PRODUCT=ws

# Guest login for run/copy tools inside Windows (or Linux) VMs
VMWARE_GUEST_USERNAME=Administrator
VMWARE_GUEST_PASSWORD=

# read-only | write | destructive
# Use "write" to clone/power/run commands; "destructive" to revert/delete
VMWARE_PERMISSION_MODE=write
