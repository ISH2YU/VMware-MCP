# Copy to .env and fill in. Every value can also be passed as a real
# environment variable; see the README for the full reference.

# --- Connection (required) --------------------------------------------------
VMWARE_HOST=vcenter.example.com
VMWARE_USERNAME=svc-mcp@vsphere.local
VMWARE_PASSWORD=

# --- TLS --------------------------------------------------------------------
# Certificate verification is on by default. Point CA_BUNDLE at your vCenter's
# CA certificate, or set VERIFY_SSL=false for a lab with a self-signed cert.
# VMWARE_VERIFY_SSL=true
# VMWARE_CA_BUNDLE=/etc/ssl/certs/vcenter-ca.pem

# --- Safety -----------------------------------------------------------------
# read-only  : inventory and monitoring only (default)
# write      : adds power operations, snapshots, clone, reconfigure, migrate
# destructive: adds deleting VMs and reverting/deleting snapshots
VMWARE_PERMISSION_MODE=read-only

# --- Tuning -----------------------------------------------------------------
# VMWARE_PORT=443
# VMWARE_CONNECT_TIMEOUT=30
# VMWARE_TASK_TIMEOUT=600
# VMWARE_MAX_RESULTS=500
# VMWARE_DEFAULT_PAGE_SIZE=100
# VMWARE_CACHE_TTL=60
# VMWARE_MAX_CONCURRENCY=8
# VMWARE_LOG_LEVEL=INFO

# --- Transport --------------------------------------------------------------
# stdio (default) is what desktop MCP clients expect.
# VMWARE_TRANSPORT=stdio
