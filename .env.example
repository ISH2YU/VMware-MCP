# Copy to .env and fill in. See the README for the full reference.
# Default backend is local Workstation / Fusion / Player.

# --- Local VMs (default) ----------------------------------------------------
# Directories to scan for .vmx files. Separate several with the OS path separator.
# Windows:  C:\Users\you\Documents\Virtual Machines
# macOS:    ~/Virtual Machines.localized
# Linux:    ~/vmware
# VMWARE_VM_DIRS=

# Optional: full path to vmrun if it is not on PATH
# VMWARE_VMRUN_PATH=

# ws (Workstation), fusion, or player. Auto-detected if unset.
# VMWARE_PRODUCT=ws

# Guest OS credentials for run/copy tools (needed for Windows test automation)
# VMWARE_GUEST_USERNAME=Administrator
# VMWARE_GUEST_PASSWORD=

# --- Safety -----------------------------------------------------------------
# read-only  : list and inspect only (default)
# write      : power, snapshots (create), clone, reconfigure, guest commands
# destructive: also revert/delete snapshots and delete VMs
VMWARE_PERMISSION_MODE=read-only

# --- Tuning -----------------------------------------------------------------
# VMWARE_COMMAND_TIMEOUT=120
# VMWARE_GUEST_TIMEOUT=300
# VMWARE_BOOT_TIMEOUT=300
# VMWARE_MAX_OUTPUT_BYTES=100000
# VMWARE_LOG_LEVEL=INFO

# --- Optional: vSphere instead of local -------------------------------------
# Setting VMWARE_HOST selects the vSphere backend automatically.
# VMWARE_BACKEND=vsphere
# VMWARE_HOST=vcenter.example.com
# VMWARE_USERNAME=svc-mcp@vsphere.local
# VMWARE_PASSWORD=
# VMWARE_VERIFY_SSL=true
